@@ -1239,6 +1239,19 @@ void VKGSRender::flip(const rsx::display_flip_info_t& info)
 	// Frame dumps (VKFrameDump.cpp) start, wait and finish on flips.
 	frame_dump_on_flip(info);
 
+	// Origami: save the driver pipeline cache every 30 s of play, off this thread. The
+	// game process is killed on exit, so waiting for device teardown loses every pipeline.
+	{
+		static std::chrono::steady_clock::time_point s_last_flush{};
+		const auto now = std::chrono::steady_clock::now();
+
+		if (now - s_last_flush > std::chrono::seconds(30))
+		{
+			s_last_flush = now;
+			vk::flush_pipeline_cache_async();
+		}
+	}
+
 	// GPU timing is driven from the flip, the only place that corresponds to a real
 	// presented frame. collect() is non-blocking: anything the GPU has not finished is
 	// left for a later call rather than waited on.
