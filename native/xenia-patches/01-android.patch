diff --git a/src/xenia/hid/origami/origami_hid.cc b/src/xenia/hid/origami/origami_hid.cc
new file mode 100644
index 0000000..ac147c5
--- /dev/null
+++ b/src/xenia/hid/origami/origami_hid.cc
@@ -0,0 +1,147 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#include "xenia/hid/origami/origami_hid.h"
+
+#include <jni.h>
+
+#include <atomic>
+#include <cstring>
+#include <mutex>
+
+#include "xenia/hid/input_driver.h"
+
+namespace xe {
+namespace hid {
+namespace origami {
+
+namespace {
+
+constexpr uint32_t kPorts = 4;
+
+struct Pad {
+  bool connected = false;
+  uint32_t packet = 0;
+  uint16_t buttons = 0;
+  uint8_t lt = 0, rt = 0;
+  int16_t lx = 0, ly = 0, rx = 0, ry = 0;
+  uint16_t rumble_l = 0, rumble_r = 0;
+};
+
+std::mutex pads_mutex;
+Pad pads[kPorts];
+
+}  // namespace
+
+class OrigamiInputDriver final : public InputDriver {
+ public:
+  OrigamiInputDriver(xe::ui::Window* window, size_t window_z_order)
+      : InputDriver(window, window_z_order) {}
+
+  X_STATUS Setup() override { return X_STATUS_SUCCESS; }
+
+  X_RESULT GetCapabilities(uint32_t user_index, uint32_t flags,
+                           X_INPUT_CAPABILITIES* out_caps) override {
+    if (!Connected(user_index)) return X_ERROR_DEVICE_NOT_CONNECTED;
+    std::memset(out_caps, 0, sizeof(*out_caps));
+    out_caps->type = 0x01;      // XINPUT_DEVTYPE_GAMEPAD
+    out_caps->sub_type = 0x01;  // XINPUT_DEVSUBTYPE_GAMEPAD
+    out_caps->gamepad.buttons = 0xF7FF;
+    out_caps->gamepad.left_trigger = 0xFF;
+    out_caps->gamepad.right_trigger = 0xFF;
+    out_caps->gamepad.thumb_lx = int16_t(0xFFC0);
+    out_caps->gamepad.thumb_ly = int16_t(0xFFC0);
+    out_caps->gamepad.thumb_rx = int16_t(0xFFC0);
+    out_caps->gamepad.thumb_ry = int16_t(0xFFC0);
+    out_caps->vibration.left_motor_speed = 0xFF;
+    out_caps->vibration.right_motor_speed = 0xFF;
+    return X_ERROR_SUCCESS;
+  }
+
+  X_RESULT GetState(uint32_t user_index, X_INPUT_STATE* out_state) override {
+    if (user_index >= kPorts) return X_ERROR_DEVICE_NOT_CONNECTED;
+    std::lock_guard<std::mutex> lock(pads_mutex);
+    const Pad& p = pads[user_index];
+    if (!p.connected) return X_ERROR_DEVICE_NOT_CONNECTED;
+    if (out_state) {
+      out_state->packet_number = p.packet;
+      out_state->gamepad.buttons = p.buttons;
+      out_state->gamepad.left_trigger = p.lt;
+      out_state->gamepad.right_trigger = p.rt;
+      out_state->gamepad.thumb_lx = p.lx;
+      out_state->gamepad.thumb_ly = p.ly;
+      out_state->gamepad.thumb_rx = p.rx;
+      out_state->gamepad.thumb_ry = p.ry;
+    }
+    return X_ERROR_SUCCESS;
+  }
+
+  X_RESULT SetState(uint32_t user_index,
+                    X_INPUT_VIBRATION* vibration) override {
+    if (user_index >= kPorts) return X_ERROR_DEVICE_NOT_CONNECTED;
+    std::lock_guard<std::mutex> lock(pads_mutex);
+    Pad& p = pads[user_index];
+    if (!p.connected) return X_ERROR_DEVICE_NOT_CONNECTED;
+    p.rumble_l = vibration->left_motor_speed;
+    p.rumble_r = vibration->right_motor_speed;
+    return X_ERROR_SUCCESS;
+  }
+
+  X_RESULT GetKeystroke(uint32_t user_index, uint32_t flags,
+                        X_INPUT_KEYSTROKE* out_keystroke) override {
+    // Les jeux se contentent de GetState ; pas de file de frappes pour l'instant.
+    return Connected(user_index) ? X_ERROR_EMPTY : X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+
+  InputType GetInputType() const override { return InputType::Controller; }
+
+ private:
+  static bool Connected(uint32_t user_index) {
+    if (user_index >= kPorts && user_index != 0xFF) return false;
+    std::lock_guard<std::mutex> lock(pads_mutex);
+    return pads[user_index == 0xFF ? 0 : user_index].connected;
+  }
+};
+
+std::unique_ptr<InputDriver> Create(xe::ui::Window* window,
+                                    size_t window_z_order) {
+  return std::make_unique<OrigamiInputDriver>(window, window_z_order);
+}
+
+}  // namespace origami
+}  // namespace hid
+}  // namespace xe
+
+using xe::hid::origami::pads;
+using xe::hid::origami::pads_mutex;
+
+// État complet d'une manette, poussé par X360Activity à chaque changement.
+extern "C" JNIEXPORT void JNICALL Java_com_hideo_foldplay_X360Activity_nativePad(
+    JNIEnv*, jclass, jint port, jboolean connected, jint buttons, jint lt,
+    jint rt, jint lx, jint ly, jint rx, jint ry) {
+  if (port < 0 || port >= 4) return;
+  std::lock_guard<std::mutex> lock(pads_mutex);
+  auto& p = pads[port];
+  p.connected = connected;
+  p.packet++;
+  p.buttons = uint16_t(buttons);
+  p.lt = uint8_t(lt);
+  p.rt = uint8_t(rt);
+  p.lx = int16_t(lx);
+  p.ly = int16_t(ly);
+  p.rx = int16_t(rx);
+  p.ry = int16_t(ry);
+}
+
+// Vibration demandée par le jeu (gauche << 16 | droite), lue par Java.
+extern "C" JNIEXPORT jint JNICALL
+Java_com_hideo_foldplay_X360Activity_nativeRumble(JNIEnv*, jclass, jint port) {
+  if (port < 0 || port >= 4) return 0;
+  std::lock_guard<std::mutex> lock(pads_mutex);
+  return jint((uint32_t(pads[port].rumble_l) << 16) | pads[port].rumble_r);
+}
